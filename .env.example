# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/campusledger

# iron-session cookie encryption password - must be at least 32 characters
SESSION_SECRET=change_this_to_a_random_string_of_at_least_32_characters

# Master key for AES-256-GCM encryption of private keys in the database.
# Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# WebAuthn (biometric login) relying party config
# For local dev, RP_ID must be "localhost" and ORIGIN must match exactly
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Used only by `npm run seed:admin` to create the first admin account.
# Admins can't self-signup, so this is the one bootstrapping step you run manually.
ADMIN_SEED_EMAIL=admin@campusledger.com
ADMIN_SEED_PASSWORD=@Meta222226

# SMTP Configuration for Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="CampusLedger" <your-email@gmail.com>
